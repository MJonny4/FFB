{
  "name": "ffb",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "typecheck": "bun run --workspaces --if-present typecheck && tsc --project tsconfig.tests.json",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "check": "bun run typecheck && bun run lint && bun run format:check && bun test",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "infra:logs": "docker compose logs -f",
    "dev:web": "bun --cwd apps/web dev",
    "build:web": "bun --cwd apps/web build",
    "lint:web": "bun --cwd apps/web lint",
    "test": "bun test",
    "test:integration": "RUN_INTEGRATION=1 bun test tests/integration.test.ts",
    "db:migrate": "bun packages/database/src/migrate.ts",
    "db:seed": "bun packages/database/src/seed.ts",
    "dev:api": "bun --watch apps/api/src/index.ts",
    "dev:worker": "bun --watch apps/worker/src/index.ts",
    "start:api": "bun apps/api/src/index.ts",
    "start:worker": "bun apps/worker/src/index.ts"
  },
  "devDependencies": {
    "@ffb/config": "workspace:*",
    "@ffb/contracts": "workspace:*",
    "@ffb/database": "workspace:*",
    "@ffb/football": "workspace:*",
    "@ffb/simulation": "workspace:*",
    "@types/bun": "latest",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "typescript": "~7.0.2"
  },
  "packageManager": "bun@1.4.4"
}
